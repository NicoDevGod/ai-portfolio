---
import Layout from '../../layouts/Layout.astro';
import { LESSONS } from '../../data/lessons';
import { PROJECTS } from '../../data/projects';
import type { Lang } from '../../data/site';
import { getUI, langStaticPaths, localePath } from '../../lib/i18n';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const ui = getUI(lang);
const byNum = (n: number) => PROJECTS.find((p) => p.num === n)!;
---

<Layout lang={lang} title={`${ui.lessons.pageTitle} · NicoDev`} description={ui.lessons.pageIntro} path="lessons">
  <section class="mx-auto max-w-4xl px-5 pt-14">
    <a href={localePath(lang)} class="text-sm text-muted transition hover:text-fg">← {ui.nav.projects}</a>
    <p class="kicker mt-8">8 / 8</p>
    <h1 class="mt-3 font-display text-4xl leading-tight text-fg sm:text-5xl">{ui.lessons.pageTitle}</h1>
    <p class="prose-p mt-5 max-w-2xl text-lg">{ui.lessons.pageIntro}</p>

    <ol class="mt-14 space-y-5">
      {LESSONS.map((l) => (
        <li id={`lesson-${l.id}`} class="card scroll-mt-24 space-y-3 p-6 md:p-8">
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-lg text-mint">{String(l.id).padStart(2, '0')}</span>
            <h2 class="font-display text-2xl leading-snug text-fg">{l.title[lang]}</h2>
          </div>
          <p class="prose-p md:pl-10">{l.body[lang]}</p>
          <p class="flex flex-wrap items-center gap-2 text-xs text-muted md:pl-10">
            <span>{ui.lessons.seenIn}</span>
            {l.projects.map((n) => (
              <a href={localePath(lang, `projects/${byNum(n).slug}`)} class="chip transition hover:border-mint/50 hover:text-fg">
                {String(n).padStart(2, '0')} · {byNum(n).title[lang]}
              </a>
            ))}
          </p>
        </li>
      ))}
    </ol>
  </section>
</Layout>
