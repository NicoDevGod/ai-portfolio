---
import type { Project } from '../data/projects';
import type { Lang } from '../data/site';
import { getUI, localePath } from '../lib/i18n';

interface Props { project: Project; lang: Lang }
const { project: p, lang } = Astro.props;
const ui = getUI(lang);
const href = localePath(lang, `projects/${p.slug}`);
const stat = p.stats[0];
---

<a href={href} class="card group flex h-full flex-col gap-4 p-6 transition hover:-translate-y-1 hover:border-mint/40 hover:bg-white/[0.06]">
  <div class="flex items-center justify-between">
    <span class="font-mono text-sm text-mint">{String(p.num).padStart(2, '0')}</span>
    <span class="chip">
      <span class:list={['inline-block size-1.5 rounded-full', p.demoUrl ? 'bg-mint' : 'bg-muted/50']}></span>
      {p.demoUrl ? ui.projects.live : ui.projects.soon}
    </span>
  </div>

  <div class="space-y-2">
    <h3 class="font-display text-2xl leading-tight text-fg">{p.title[lang]}</h3>
    <p class="text-sm leading-relaxed text-muted">{p.tagline[lang]}</p>
  </div>

  <div class="mt-auto space-y-4">
    <div class="rounded-lg border border-line bg-black/20 px-3 py-2">
      <p class="font-mono text-lg text-fg">{stat.value}</p>
      <p class="text-xs text-muted">{stat.label[lang]}</p>
    </div>
    <div class="flex flex-wrap gap-1.5">
      {p.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <p class="text-sm font-semibold text-mint transition group-hover:translate-x-1">{ui.projects.open} →</p>
  </div>
</a>
